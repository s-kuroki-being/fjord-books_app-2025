<p style="color: green"><%= notice %></p>

<% content_for :title, t("books.page.index_title") %>

<h1><%= t("books.page.index_title") %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t("books.actions.show"), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t("books.actions.new"), new_book_path %>
</nav>
